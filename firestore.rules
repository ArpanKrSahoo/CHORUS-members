rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return isSignedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : "";
    }

    function isPredefinedAdmin() {
      return authEmail() in [
        "kunal.mitra2024@chorus.com",
        "arpan.kumarsahoo2024@chorus.com"
      ];
    }

    function memberRole() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/members/$(authEmail()))
        ? get(/databases/$(database)/documents/members/$(authEmail())).data.role
        : "member";
    }

    function isAdmin() {
      return isPredefinedAdmin() || memberRole() == "admin";
    }

    function isDirector() {
      return memberRole() == "director";
    }

    function canManageLiveContent() {
      return isAdmin() || isDirector();
    }

    function isAssignedProductionDirector(productionId) {
      return isDirector()
        && exists(/databases/$(database)/documents/productions/$(productionId))
        && get(/databases/$(database)/documents/productions/$(productionId)).data.directorEmails.hasAny([authEmail()]);
    }

    function isText(value, maxLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLength;
    }

    function hasOptionalText(fieldName, maxLength) {
      return !request.resource.data.keys().hasAny([fieldName])
        || (
          request.resource.data.get(fieldName, "") is string
          && request.resource.data.get(fieldName, "").size() <= maxLength
        );
    }

    function hasOptionalTimestamp(fieldName) {
      return !request.resource.data.keys().hasAny([fieldName])
        || request.resource.data.get(fieldName, request.time) is timestamp;
    }

    function isValidMember(memberEmail) {
      return request.resource.data.keys().hasOnly([
          "authUid",
          "createdAt",
          "email",
          "role",
          "updatedAt"
        ])
        && request.resource.data.email == memberEmail
        && isText(request.resource.data.authUid, 128)
        && request.resource.data.createdAt is timestamp
        && hasOptionalTimestamp("updatedAt")
        && request.resource.data.role in ["member", "admin", "director"];
    }

    function isValidNotice() {
      return request.resource.data.keys().hasOnly([
          "body",
          "createdAt",
          "title",
          "updatedAt"
        ])
        && isText(request.resource.data.title, 120)
        && isText(request.resource.data.body, 3000)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidRehearsal() {
      return request.resource.data.keys().hasOnly([
          "createdAt",
          "location",
          "note",
          "rehearsalAt",
          "title",
          "updatedAt"
        ])
        && isText(request.resource.data.title, 120)
        && request.resource.data.rehearsalAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && hasOptionalText("location", 160)
        && hasOptionalText("note", 1200);
    }

    function isValidProductionRoles() {
      return request.resource.data.roles is list
        && request.resource.data.roles.size() <= 300;
    }

    function isValidProduction() {
      return request.resource.data.keys().hasOnly([
          "createdAt",
          "directorEmails",
          "notes",
          "roles",
          "title",
          "updatedAt"
        ])
        && isText(request.resource.data.title, 160)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.directorEmails is list
        && request.resource.data.directorEmails.size() > 0
        && request.resource.data.directorEmails.size() <= 12
        && isValidProductionRoles()
        && request.resource.data.notes is list
        && request.resource.data.notes.size() <= 200;
    }

    function keepsProductionDirectorsUnchanged() {
      return request.resource.data.directorEmails == resource.data.directorEmails;
    }

    function isValidAttendanceRehearsal(rehearsalId) {
      return request.resource.data.rehearsal is map
        && request.resource.data.rehearsal.keys().hasOnly([
          "id",
          "rehearsalAt",
          "title"
        ])
        && request.resource.data.rehearsal.id == rehearsalId
        && request.resource.data.rehearsal.rehearsalAt is timestamp
        && isText(request.resource.data.rehearsal.title, 160);
    }

    function isValidAttendance(rehearsalId) {
      return request.resource.data.keys().hasOnly([
          "records",
          "rehearsal",
          "rehearsalId",
          "updatedAt",
          "updatedBy"
        ])
        && isText(request.resource.data.rehearsalId, 128)
        && isValidAttendanceRehearsal(rehearsalId)
        && request.resource.data.records is map
        && request.resource.data.updatedAt is timestamp
        && isText(request.resource.data.updatedBy, 160);
    }

    match /members/{memberEmail} {
      allow read: if isSignedIn() && (authEmail() == memberEmail || isAdmin() || isDirector());
      allow create: if (
          isAdmin()
          || authEmail() == memberEmail && request.resource.data.role == "member"
        )
        && isValidMember(memberEmail);
      allow update: if isAdmin() && isValidMember(memberEmail);
      allow delete: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow create, update: if canManageLiveContent() && isValidNotice();
      allow delete: if canManageLiveContent();
    }

    match /rehearsals/{rehearsalId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidRehearsal();
      allow update: if isAdmin()
        && isValidRehearsal()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /attendance/{rehearsalId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        && request.resource.data.rehearsalId == rehearsalId
        && isValidAttendance(rehearsalId);
      allow delete: if isAdmin();
    }

    match /productions/{productionId} {
      allow read: if isSignedIn();
      allow create: if isValidProduction()
        && (
          isAdmin()
          || isDirector()
          && request.resource.data.directorEmails == [authEmail()]
        );
      allow update: if isValidProduction()
        && (
          isAdmin()
          || isAssignedProductionDirector(productionId)
          && keepsProductionDirectorsUnchanged()
        );
      allow delete: if isAdmin() || isAssignedProductionDirector(productionId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
